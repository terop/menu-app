FROM ghcr.io/astral-sh/uv:python3.14-alpine AS builder

ENV UV_COMPILE_BYTECODE=1
WORKDIR /app
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-workspace --package scraper --no-dev

FROM python:3.14-alpine

ENV PYTHONUNBUFFERED=1

RUN apk add --no-cache dumb-init

# Add user to run the app
ARG APPLICATION_USER=appuser
RUN adduser --no-create-home -u 1000 -D ${APPLICATION_USER} \
    && mkdir /usr/src/app \
    && chown -R ${APPLICATION_USER} /usr/src/app

WORKDIR /usr/src/app

# Copy the virtual environment from the builder
COPY --from=builder --chown=${APPLICATION_USER}:${APPLICATION_USER} \
    /app/.venv /usr/src/app/.venv

COPY --chown=${APPLICATION_USER}:${APPLICATION_USER} \
     scraper/config.toml scraper/menu_scraper.py ./

# Place executables in the environment at the front of the path
ENV PATH="/usr/src/app/.venv/bin:${PATH}"

LABEL org.opencontainers.image.authors="tero.paloheimo@iki.fi"

USER ${APPLICATION_USER}
ENTRYPOINT ["dumb-init", "python", "menu_scraper.py"]
